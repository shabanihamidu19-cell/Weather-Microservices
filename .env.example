# Example environment variables for Weather Microservice
# Copy this file to `.env` and fill in the values before running locally.

# OpenWeatherMap API key (optional). If not set, the service will return mock data.
WEATHER_API_KEY=your_openweathermap_key

# Provider to use (default: openweathermap)
WEATHER_PROVIDER=openweathermap

# Default city used when no ?city= query param is provided
WEATHER_DEFAULT_CITY=Dar es Salaam

# HTTP port
PORT=3000

# Set to 'test' when running tests so the server does not start a listener
NODE_ENV=development
